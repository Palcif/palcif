Google_APIKey=""

# Formspree form ID that the Contact page submits to (https://formspree.io/f/<id>).
# Without this set, the contact form shows an error instead of submitting.
VITE_FORMSPREE_ID=""

# WordPress GraphQL endpoint
# Prod:  https://your-wp-site.com/graphql
# Local: http://localhost:8080/graphql
VITE_WP_GRAPHQL_URL=https://your-wp-site.com/graphql
