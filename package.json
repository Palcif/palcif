{
  "name": "palcif-html",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run codegen && tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc -p tsconfig.app.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:schema": "node --env-file-if-exists=.env node_modules/.bin/graphql-codegen --config codegen.schema.ts",
    "prepare": "husky",
    "deploy": "npm run build && wrangler deploy"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.12",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "i18next": "^26.3.1",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "react-router": "^7.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.114.0"
  }
}
